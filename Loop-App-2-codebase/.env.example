# Supabase Public Configuration (Exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Canonical public origin (used by robots.txt, sitemap.xml, and OpenGraph URLs)
NEXT_PUBLIC_SITE_URL=https://loop-app.runs-on.dev

# Supabase Server-Side Secret Key (Never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cron Job Authentication Secret (For automated cleanups)
CLEANUP_CRON_SECRET=your-cleanup-cron-secret-token

# Bearer token for /api/admin/stats (optional; falls back to CLEANUP_CRON_SECRET)
ADMIN_STATS_SECRET=your-admin-stats-secret-token

# Bearer token for /api/admin/sync-whitelist (optional; falls back to SUPABASE_SERVICE_ROLE_KEY)
CRON_SECRET=your-cron-secret-token

# Admin & Developer Configuration
# Comma-separated list of whitelisted admin/developer email addresses
ADMIN_EMAILS=developer@campus.edu,admin@campus.edu

# Public Support & Contact Email (Displayed in Terms, Privacy, and Help modals)
NEXT_PUBLIC_SUPPORT_EMAIL=support@loopcampus.in

# Public Creator Handle (Optional social/github handle)
NEXT_PUBLIC_CREATOR_HANDLE=@loop.campus

# Quota for Non-Educational External Signups (Default: 100)
MAX_EXTERNAL_EMAILS=100

# Progressive Web App (PWA) / Trusted Web Activity (TWA) Configuration
NEXT_PUBLIC_PACKAGE_NAME=app.loop.twa
# Leave empty until you have real signing fingerprints from Play Console /
# keytool. All-zero placeholder digests are rejected by the route handler.
ASSETLINKS_SHA256=

# Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

