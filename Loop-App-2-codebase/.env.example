# Supabase Public Configuration (Exposed to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase Server-Side Secret Key (Never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cron Job Authentication Secret (For automated cleanups)
CLEANUP_CRON_SECRET=your-cleanup-cron-secret-token

# Admin & Developer Configuration
# Comma-separated list of whitelisted admin/developer email addresses
ADMIN_EMAILS=developer@campus.edu,admin@campus.edu

# Public Support & Contact Email (Displayed in Terms, Privacy, and Help modals)
NEXT_PUBLIC_SUPPORT_EMAIL=support@loopcampus.in

# Public Creator Handle (Optional social/github handle)
NEXT_PUBLIC_CREATOR_HANDLE=@loop.campus

# Quota for Non-Educational External Signups (Default: 100)
MAX_EXTERNAL_EMAILS=100

# Progressive Web App (PWA) / Trusted Web Activity (TWA) Configuration
NEXT_PUBLIC_PACKAGE_NAME=app.loop.twa
ASSETLINKS_SHA256=00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00:00

# Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

